#!/usr/bin/env bash
# Affiche l'état local et les commandes facultatives de ForgeHistory.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"

printf 'ForgeHistory\n'
printf '  branche : %s\n' "$(git branch --show-current)"
printf '  état Git :\n'
git status --short --branch

printf '\nWorkflow direct :\n'
printf '  1. choisir une tâche dans ROADMAP.md ou un brief existant\n'
printf '  2. modifier, tester, documenter et examiner le diff\n'
printf '  3. ouvrir une PR ou livrer selon le contexte\n'

printf '\nAides facultatives :\n'
printf '  python3 -m sim --ticks 0 --json\n'
printf '  python3 hermes/dashboard.py\n'
printf '  .venv/bin/forgepilot doctor --repo %s\n' "$REPO_DIR"
printf '  hermes/crons/quotidien.sh\n'
