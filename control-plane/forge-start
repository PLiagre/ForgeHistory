#!/usr/bin/env bash
# forge-start — reprendre le travail sur ForgeHistory en une commande.
#
# Ne démarre RIEN de permanent : tout ce que ce script lance meurt avec la
# session WSL. Conforme aux contraintes du pilote (pas de cron, pas de
# service, ROADMAP.md étape 2 + ADR-0013).
#
# Usage :  forge-start
#          forge-start --stop     (arrête le dashboard)

set -euo pipefail

REPO="$HOME/src/ForgeHistory"
PORT=9119
export PATH="$HOME/.local/bin:$PATH"

bleu()  { printf '\033[1;34m%s\033[0m\n' "$*"; }
vert()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
jaune() { printf '\033[0;33m%s\033[0m\n' "$*"; }

if [[ "${1:-}" == "--stop" ]]; then
    pkill -f "hermes dashboard" 2>/dev/null && vert "Dashboard arrêté." \
        || jaune "Aucun dashboard à arrêter."
    exit 0
fi

cd "$REPO"

bleu "── ForgeHistory ──────────────────────────────────"

# 1. Dashboard web (démarré seulement s'il ne tourne pas déjà)
if ss -tln 2>/dev/null | grep -q ":$PORT "; then
    vert "✓ Dashboard déjà en ligne    → http://127.0.0.1:$PORT"
else
    nohup hermes dashboard --no-open > "$HOME/.hermes/dashboard.log" 2>&1 &
    for _ in $(seq 1 30); do
        ss -tln 2>/dev/null | grep -q ":$PORT " && break
        sleep 1
    done
    if ss -tln 2>/dev/null | grep -q ":$PORT "; then
        vert "✓ Dashboard lancé            → http://127.0.0.1:$PORT"
    else
        jaune "✗ Dashboard : échec — voir ~/.hermes/dashboard.log"
    fi
fi

# 2. Vue projet ForgeHistory — on NE la régénère PAS localement.
#    hermes/dashboard.py sans accès à l'API GitHub produit une version
#    dégradée (perd la section « Activité GitHub récente ») : la régénérer
#    ici salirait le dépôt à chaque démarrage.
#    Depuis ADR-0013, PLUS RIEN ne la régénère tout seul — ni cron, ni
#    poussée. Le workflow .github/workflows/hermes-dashboard.yml est en
#    déclenchement manuel (workflow_dispatch). On se contente donc de dire
#    de quand elle date, et de prévenir si elle a vieilli.
if [[ -f hermes/DASHBOARD.md ]]; then
    vue_date="$(grep -m1 'Générée le' hermes/DASHBOARD.md | sed 's/> *//')"
    jours=$(( ( $(date +%s) - $(git log -1 --format=%ct -- hermes/DASHBOARD.md) ) / 86400 ))
    if (( jours >= 1 )); then
        jaune "⚠ Vue projet : $vue_date  — $jours jour(s), personne ne la"
        jaune "               régénère automatiquement (ADR-0013)."
        jaune "               À jour : py hermes/dashboard.py   (vue locale,"
        jaune "               sans la section « Activité GitHub récente »)"
    else
        vert "✓ Vue projet : $vue_date"
    fi
fi

# 3. État réel du dépôt et du pilote
echo
bleu "── État ──────────────────────────────────────────"
printf '  branche   : %s\n' "$(git branch --show-current)"
printf '  git       : %s\n' \
    "$(if [[ -z "$(git status --porcelain)" ]]; then echo 'propre'; \
       else echo "$(git status --porcelain | wc -l) fichier(s) non committé(s)"; fi)"
printf '  modèle    : %s\n' \
    "$(grep -A3 '^model:' "$HOME/.hermes/config.yaml" | grep 'default:' | sed 's/.*default: *//')"

if "$REPO/.venv/bin/forgepilot" doctor --repo "$REPO" --check-auth > /dev/null 2>&1; then
    vert "  pilote    : doctor OK (auth Claude Code / Cursor / GitHub)"
else
    jaune "  pilote    : doctor en échec — lancer .venv/bin/forgepilot doctor --repo $REPO --check-auth"
fi

# 4. Où reprendre
echo
bleu "── Reprendre ─────────────────────────────────────"
echo
vert  "  ▶  hermes chat -s forgehistory-suivi"
echo
echo  "     C'est la seule commande à taper. Hermes fait le point tout seul"
echo  "     (dashboard, HANDOFF, ROADMAP, doctor) et vous dit où on en est."
echo  "     Le -s n'est pas optionnel : sans lui, Hermes ne sait pas qu'il"
echo  "     est chef de projet."
echo
echo  "  À lire si vous voulez vérifier par vous-même :"
echo  "     hermes/DASHBOARD.md   (briefs, audits, coûts)"
echo  "     HANDOFF.md            (état de fin de dernière session)"
echo  "     http://127.0.0.1:$PORT   (console web Hermes)"
echo
jaune "  Cron quotidien autorisé (lecture seulement) :"
jaune "     hermes/crons/quotidien.sh   (voir hermes/crons/README.md)"
echo
