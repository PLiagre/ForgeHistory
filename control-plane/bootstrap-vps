#!/usr/bin/env bash
# Prépare facultativement ForgePilot sur une machine Linux.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${REPO_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"

for tool in git python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "ERREUR : $tool est requis pour cette installation locale." >&2
    exit 1
  fi
done

if [[ ! -d "$REPO_DIR/.git" ]]; then
  echo "ERREUR : dépôt Git introuvable dans $REPO_DIR" >&2
  exit 1
fi

cd "$REPO_DIR"
if [[ ! -x .venv/bin/python ]]; then
  python3 -m venv .venv
fi
.venv/bin/pip install --quiet -e ./control-plane

echo "ForgePilot installé : $REPO_DIR/.venv/bin/forgepilot"
echo "Vérification locale : .venv/bin/forgepilot doctor --repo '$REPO_DIR'"
echo "Les CLI externes et leurs authentifications ne sont nécessaires que pour"
echo "les commandes qui les utilisent. Le développement du dépôt n'en dépend pas."
