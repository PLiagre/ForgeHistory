/* victoria-theme.uss — tokens / palette / typographie (v1_054 DA médiévale sombre)
 *
 * Classes publiques documentées ici :
 *   (aucune classe composant — tokens uniquement)
 *
 * Variables CSS (palette normative docs/ui/PLAN-DA-medievale-sombre.md) :
 *   --hud-void, --hud-iron, --hud-iron-raised, --hud-parchment, --hud-bone,
 *   --hud-brass, --hud-blood, --hud-moss, --hud-ash,
 *   --hud-bar-bg, --hud-text, --hud-text-priority, --hud-text-muted,
 *   --hud-btn-idle, --hud-btn-hover, --hud-btn-active, --hud-btn-border,
 *   --hud-btn-paused, --hud-btn-disabled,
 *   --hud-font-title, --hud-font-section, --hud-font-body, --hud-font-panel, --hud-font-micro,
 *   --hud-radius, --hud-transition
 */

:root {
    --hud-void: rgb(18, 17, 15);
    --hud-iron: rgb(33, 31, 27);
    --hud-iron-raised: rgb(48, 44, 38);
    --hud-parchment: rgb(200, 183, 143);
    --hud-bone: rgb(221, 210, 186);
    --hud-brass: rgb(154, 122, 67);
    --hud-blood: rgb(103, 46, 43);
    --hud-moss: rgb(70, 81, 63);
    --hud-ash: rgb(117, 111, 100);

    --hud-bar-bg: rgba(33, 31, 27, 0.94);
    --hud-text: var(--hud-parchment);
    --hud-text-priority: var(--hud-bone);
    --hud-text-muted: var(--hud-ash);

    --hud-btn-idle: var(--hud-iron-raised);
    --hud-btn-hover: rgb(58, 52, 44);
    --hud-btn-active: var(--hud-moss);
    --hud-btn-border: var(--hud-brass);
    --hud-btn-paused: var(--hud-blood);
    --hud-btn-disabled: rgb(28, 26, 23);

    --hud-font-title: 18px;
    --hud-font-section: 14px;
    --hud-font-body: 13px;
    --hud-font-panel: 12px;
    --hud-font-micro: 11px;

    --hud-radius: 2px;
    --hud-transition: 110ms;
}

.hud {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--hud-void);
}
