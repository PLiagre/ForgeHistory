<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Charpente HUD runtime v1_054/v1_055 — DA médiévale sombre ; responsive via classes géométrie. -->
    <ui:Style src="victoria-theme.uss" />
    <ui:Style src="victoria-components.uss" />

    <ui:VisualElement name="MapRoot" class="hud__map" focusable="true" tabindex="-1" />

    <ui:VisualElement name="TopBar" class="hud__topbar">
        <ui:VisualElement name="TopBarContext" class="hud__topbar-zone hud__topbar-zone--context">
            <ui:Label name="ViewContextLabel" class="hud__view-context" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="TopBarMetrics" class="hud__topbar-zone hud__topbar-zone--metrics">
            <ui:Label name="InfoBar" class="hud__infobar" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="TopBarTime" class="hud__topbar-zone hud__topbar-zone--time">
            <ui:Label name="DateLabel" class="hud__date" text="" />
            <ui:VisualElement name="PaceBar" class="hud__pacebar">
                <ui:Label name="PaceStatusBadge" class="hud__pace-badge" text="" />
                <ui:Button name="PacePauseButton" class="hud-btn hud-btn--idle" text="Pause" tabindex="0" tooltip="Mettre en pause ou reprendre" />
                <ui:Button name="ZoomOutButton" class="hud-btn hud-btn--idle" text="Zoom-" tabindex="1" tooltip="Reculer d'un niveau de zoom" />
                <ui:Button name="PaceSpeed_0.5x" class="hud-btn hud-btn--idle" text="0.5x" tabindex="2" tooltip="Vitesse demi" />
                <ui:Button name="PaceSpeed_1x" class="hud-btn hud-btn--idle" text="1x" tabindex="3" tooltip="Vitesse normale" />
                <ui:Button name="PaceSpeed_2x" class="hud-btn hud-btn--idle" text="2x" tabindex="4" tooltip="Vitesse double" />
                <ui:Button name="PaceSpeed_4x" class="hud-btn hud-btn--idle" text="4x" tabindex="5" tooltip="Vitesse quadruple" />
                <ui:Button name="PaceSpeed_8x" class="hud-btn hud-btn--idle" text="8x" tabindex="6" tooltip="Vitesse octuple" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Label name="HoverLabel" class="hud__hover is-hidden" text="" />

    <ui:VisualElement name="ProvincePanel" class="hud__panel hud__panel--province is-hidden">
        <ui:Label name="ProvincePanel_Title" class="panel__title" text="" />
        <ui:Label name="ProvincePanel_Subtitle" class="panel__subtitle" text="" />
        <ui:VisualElement name="ProvincePanel_Sections" class="panel__sections" />
        <ui:VisualElement name="ProvincePanel_Alerts" class="panel__alerts" />
    </ui:VisualElement>

    <ui:VisualElement name="CountryPanel" class="hud__panel hud__panel--country is-hidden">
        <ui:Label name="CountryPanel_Title" class="panel__title" text="" />
        <ui:Label name="CountryPanel_Subtitle" class="panel__subtitle" text="" />
        <ui:VisualElement name="CountryPanel_Sections" class="panel__sections" />
        <ui:VisualElement name="CountryPanel_Alerts" class="panel__alerts" />
    </ui:VisualElement>

    <ui:VisualElement name="TaxBar" class="hud__taxbar is-hidden">
        <ui:Label name="TaxTitleLabel" class="tax__title" text="Impôt" />
        <ui:VisualElement name="TaxControls" class="tax__controls">
            <ui:Button name="TaxDownButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Impôt −" tabindex="7" tooltip="Baisser le taux d'impôt" />
            <ui:Label name="TaxStatusLabel" class="hud__tax-status" text="" />
            <ui:Button name="TaxUpButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Impôt +" tabindex="8" tooltip="Augmenter le taux d'impôt" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="InvestBar" class="hud__taxbar is-hidden">
        <ui:Label name="InvestTitleLabel" class="tax__title" text="Investir" />
        <ui:Label name="InvestStatusLabel" class="hud__tax-status" text="" />
        <ui:VisualElement name="InvestControls" class="tax__controls">
            <ui:Button name="InvestTaxButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Tax +" tabindex="9" tooltip="Investir +1 Tax" />
            <ui:Button name="InvestProdButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Prod +" tabindex="10" tooltip="Investir +1 Production" />
            <ui:Button name="InvestManButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Man +" tabindex="11" tooltip="Investir +1 Manpower" />
            <ui:Button name="BuildFarmButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Construire Ferme" tabindex="12" tooltip="Démarrer une construction Farm dans une ville de la province" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="WarBar" class="hud__taxbar is-hidden">
        <ui:Label name="WarTitleLabel" class="tax__title" text="Guerre" />
        <ui:Label name="WarStatusLabel" class="hud__tax-status" text="" />
        <ui:VisualElement name="WarControls" class="tax__controls">
            <ui:Button name="DeclareWarButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Déclarer guerre" tabindex="13" tooltip="Déclarer la guerre au pays visualisé" />
            <ui:Button name="ProposePeaceButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Proposer paix" tabindex="14" tooltip="Proposer une paix blanche au pays visualisé" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="LawBar" class="hud__taxbar is-hidden">
        <ui:Label name="LawTitleLabel" class="tax__title" text="Lois" />
        <ui:Label name="LawStatusLabel" class="hud__tax-status" text="" />
        <ui:VisualElement name="LawControls" class="tax__controls">
            <ui:Button name="EnactLawButton" class="hud-btn hud-btn--idle hud-btn--tax" text="Promulguer land_tax" tabindex="15" tooltip="Promulguer la loi land_tax (intention EnactLaw)" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
