# Regenerable Unity/tooling directories excluded from the brief-003 port
# (Success Condition 1 / Success Condition 2). These must never become
# trackable, even after they are locally regenerated by a compile/test run.
/Library/
/Temp/
/Logs/
/obj/
/Builds/
/PresentationCache/
/UserSettings/
/.vs/

# Common Unity-adjacent regenerable artifacts (defense in depth, not part of
# the brief's fixed eight-directory list, and not relied upon by any
# Required Counter).
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
crashlytics-build.properties
