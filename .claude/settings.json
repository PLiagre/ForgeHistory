{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(C:/Users/liagr/VictoriaProject/**)",
      "Write(C:/Users/liagr/VictoriaProject/**)",
      "Bash(rm -rf C:/Users/liagr/VictoriaProject*)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_bare_python.py\"",
            "timeout": 5
          }
        ],
        "description": "Bloque les invocations de `python` nu — faux alias du Store sur cette machine ; employer `py`.",
        "id": "pre:bash:no-bare-python"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git_push.py\"",
            "timeout": 30
          }
        ],
        "description": "Bloque `git push` si sim/tests/ ou viewer/tests/ est rouge.",
        "id": "pre:bash:guard-git-push"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_vision_edit.py\"",
            "timeout": 5
          }
        ],
        "description": "Bloque les modifications de VISION.md sauf si FORGE_ALLOW_VISION_EDIT=1 est posé.",
        "id": "pre:edit:guard-vision"
      }
    ]
  }
}
