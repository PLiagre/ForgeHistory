{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(C:/Users/liagr/VictoriaProject/**)",
      "Write(C:/Users/liagr/VictoriaProject/**)",
      "Bash(rm -rf C:/Users/liagr/VictoriaProject*)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_bare_python.py\"",
            "timeout": 5
          }
        ],
        "description": "Garde technique locale : employer `python3` sous Linux ou `py` sous Windows.",
        "id": "pre:bash:no-bare-python"
      }
    ]
  }
}
